# RoadWatch Environment Variables Template
# Copy this file to .env and fill in your values
# LOCAL: Use this for local development
# GCP: Use for Google Cloud Platform deployment
# DO NOT COMMIT REAL .env FILE (add to .gitignore)

# ============================================================================
# AUTHENTICATION (MVP: Demo mode, no validation)
# ============================================================================

# Officer/Reviewer access token (any value in MVP)
# PRODUCTION: JWT token, OAuth, OIDC
ROADWATCH_REVIEWER_TOKEN=local-reviewer-only

# Citizen identity header (any value in MVP)
# PRODUCTION: OIDC token, federated identity
ROADWATCH_CITIZEN_IDENTITY=demo-citizen

# ============================================================================
# DATABASE (Local vs. Cloud)
# ============================================================================

# LOCAL DEVELOPMENT: SQLite (default)
# DATABASE_URL=sqlite:///./roadwatch.db

# GCP PRODUCTION: PostgreSQL via Cloud SQL Auth Proxy
# DATABASE_URL=postgresql://roadwatch_user:PASSWORD@/roadwatch?host=/cloudsql/PROJECT:us-central1:roadwatch-db

# DATABASE_URL=sqlite:///./roadwatch.db

# ============================================================================
# MEDIA STORAGE (Local vs. Cloud)
# ============================================================================

# LOCAL DEVELOPMENT: Local filesystem
# MEDIA_STORE_PATH=./media_store

# GCP PRODUCTION: Google Cloud Storage
# MEDIA_STORE_PATH=gs://roadwatch-media-PROJECT_ID

MEDIA_STORE_PATH=./media_store

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Server host (0.0.0.0 = all interfaces, 127.0.0.1 = localhost only)
ROADWATCH_HOST=0.0.0.0

# Server port
ROADWATCH_PORT=8000

# Environment: development, staging, production
ENVIRONMENT=development

# Reload on code changes (development only)
RELOAD=true

# ============================================================================
# LOGGING & MONITORING
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable structured logging (JSON format)
STRUCTURED_LOGGING=false

# OpenTelemetry exporter endpoint (optional)
# LOCAL: Leave empty (no export)
# GCP: https://monitoring.googleapis.com:443
# OTEL_EXPORTER_OTLP_PROTO_HTTP_ENDPOINT=

OTEL_EXPORTER_OTLP_PROTO_HTTP_ENDPOINT=

# ============================================================================
# AI SCREENING (Optional, Phase 2)
# ============================================================================

# OpenAI API key (get from https://platform.openai.com/api-keys)
# Leave empty to disable AI screening
OPENAI_API_KEY=

# OpenAI model (default: gpt-4o-mini, cheaper than gpt-4)
OPENAI_MODEL=gpt-4o-mini

# OpenAI max tokens for AI response
OPENAI_MAX_TOKENS=1000

# Enable AI screening (true/false)
ENABLE_AI_SCREENING=false

# ============================================================================
# EXTERNAL INTEGRATIONS (Phase 2+)
# ============================================================================

# VAHAN vehicle verification API (placeholder)
# VAHAN_API_KEY=

# Police registration system (placeholder)
# POLICE_API_URL=https://api.police.gov.in

# e-Challan integration (placeholder)
# ECHALLAN_API_KEY=

# ============================================================================
# CORS & SECURITY (Production)
# ============================================================================

# Allowed origins (comma-separated)
# LOCAL: http://127.0.0.1:8000,http://localhost:8000
# GCP: https://roadwatch.example.com
ALLOWED_ORIGINS=http://127.0.0.1:8000

# Enable CORS
ENABLE_CORS=true

# CORS max age (seconds)
CORS_MAX_AGE=3600

# ============================================================================
# RATE LIMITING (Production)
# ============================================================================

# Enable rate limiting
ENABLE_RATE_LIMITING=false

# Requests per minute (global)
RATE_LIMIT_REQUESTS=100

# Rate limit window (seconds)
RATE_LIMIT_WINDOW=60

# ============================================================================
# DATABASE POOL (Production)
# ============================================================================

# Connection pool size (for PostgreSQL)
DB_POOL_SIZE=10

# Max overflow connections
DB_MAX_OVERFLOW=20

# Connection timeout (seconds)
DB_CONNECT_TIMEOUT=10

# Pool recycle time (seconds)
DB_POOL_RECYCLE=3600

# ============================================================================
# FEATURES FLAGS
# ============================================================================

# Enable citizen signup (default: false, demo mode)
ENABLE_CITIZEN_SIGNUP=false

# Enable evidence export (M6, default: true)
ENABLE_EVIDENCE_EXPORT=true

# Enable offline mode (default: false)
ENABLE_OFFLINE_MODE=false

# Polling interval for status updates (milliseconds)
POLLING_INTERVAL_MS=30000

# ============================================================================
# BACKUP & RECOVERY
# ============================================================================

# Enable automatic backups
ENABLE_BACKUPS=false

# Backup interval (hours)
BACKUP_INTERVAL_HOURS=24

# Backup retention (days)
BACKUP_RETENTION_DAYS=30

# Backup location (local or cloud)
# LOCAL: ./backups
# GCP: gs://roadwatch-backups-PROJECT_ID
BACKUP_LOCATION=./backups

# ============================================================================
# GCP SPECIFIC (Only needed for GCP deployment)
# ============================================================================

# GCP Project ID
GCP_PROJECT_ID=

# GCP Region (default: us-central1)
GCP_REGION=us-central1

# Google Cloud Storage bucket for media
GCS_MEDIA_BUCKET=gs://roadwatch-media-PROJECT_ID

# Google Cloud SQL connection name
CLOUD_SQL_CONNECTION_NAME=PROJECT:us-central1:roadwatch-db

# Google Cloud Run service name
CLOUD_RUN_SERVICE=roadwatch

# ============================================================================
# DEVELOPMENT / TESTING
# ============================================================================

# Test mode (skip certain validations)
TEST_MODE=false

# Mock external services (AI, VAHAN, etc.)
MOCK_EXTERNAL_SERVICES=false

# Enable debug endpoints (/debug/*, /metrics/*)
DEBUG_ENDPOINTS=false

# Database to use for testing
TEST_DATABASE_URL=sqlite:///:memory:

# ============================================================================
# NOTES
# ============================================================================

# 1. COPY THIS FILE:
#    cp .env.example .env
#
# 2. EDIT WITH YOUR VALUES:
#    nano .env (or editor of choice)
#
# 3. LOAD IN PYTHON:
#    from dotenv import load_dotenv
#    import os
#    load_dotenv()
#    token = os.getenv("ROADWATCH_REVIEWER_TOKEN")
#
# 4. NEVER COMMIT .env FILE:
#    echo ".env" >> .gitignore
#    git rm --cached .env  (if already committed)
#
# 5. SHARE SAFELY:
#    - Use .env.example (no secrets)
#    - Use GCP Secret Manager for production
#    - Use GitHub Secrets for CI/CD
#
# ============================================================================
